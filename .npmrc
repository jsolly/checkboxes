# npx never installs: a tool that is not in node_modules/.bin fails closed ("npx canceled due to
# missing packages") instead of fetching <tool>@latest from the registry. `npx --yes` opts in
# explicitly. This repository requires an explicit opt-in for package downloads.
yes=false
# Wait 7 days before resolving a newly published package. The current lockfile
# still installs; Dependabot uses the same cooldown.
min-release-age=7
