{
	"name": "static-astro-website",
	"type": "module",
	"version": "0.0.1",
	"license": "MIT",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "astro dev",
		"prebuild": "node scripts/gen-release-id.mjs",
		"build": "astro build",
		"postbuild": "node scripts/restore-release-stub.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"prepare": "if [ -z \"$CI\" ] && git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .git-hooks; fi",
		"lint": "biome lint .",
		"lint-fix": "biome lint --write .",
		"format": "biome format --write .",
		"check:biome": "biome check --write . --error-on-warnings",
		"check:ts": "astro check --minimumSeverity warning --minimumFailingSeverity warning",
		"check:md": "bash scripts/lint-md.sh",
		"check:yaml": "uvx yamllint@1.38.0 -s .",
		"check:release-id": "node scripts/check-release-id.mjs",
		"generate-stats": "tsx src/utils/generate-stats.ts",
		"worktree:init": "bash scripts/worktree-init.sh; npm ci",
		"test": "tsx --test --test-reporter=dot \"tests/**/*.test.ts\"",
		"lint-staged": "lint-staged",
		"check:actions": "bash scripts/check-actions.sh"
	},
	"lint-staged": {
		".agents/**": [],
		"!(.agents)/**/*": [
			"biome check --no-errors-on-unmatched --write --error-on-warnings"
		]
	},
	"overrides": {
		"path-to-regexp": ">=6.3.0",
		"tar-fs": ">=3.0.9",
		"brace-expansion": ">=2.0.2",
		"tar": ">=7.5.11",
		"defu": ">=6.1.5",
		"devalue": ">=5.3.2",
		"fast-uri": ">=3.1.1",
		"glob": ">=10.5.0",
		"lodash": ">=4.18.0",
		"minimatch": ">=9.0.6",
		"rollup": ">=4.59.0",
		"h3": ">=1.15.8",
		"picomatch": ">=2.3.2",
		"undici": ">=6.24.0",
		"vite": ">=8.0.13"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/react": "^6.0.4",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/svelte": "^9.0.1",
		"@astrojs/vercel": "^11.0.7",
		"@astrojs/vue": "^7.0.2",
		"@google/genai": "^2.18.0",
		"@hotwired/stimulus": "^3.2.2",
		"@types/alpinejs": "^3.13.11",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.2.4",
		"@vercel/edge": "^1.3.3",
		"alpinejs": "^3.16.2",
		"astro": "^7.2.3",
		"dotenv": "^17.4.2",
		"jquery": "^4.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sharp": "^0.35.3",
		"shiki": "^4.4.3",
		"sortablejs": "^1.15.6",
		"svelte": "^5.56.10",
		"tailwindcss": "^4.3.2",
		"vue": "^3.5.41"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@tailwindcss/vite": "^4.3.3",
		"@types/jquery": "^4.0.1",
		"@types/node": "^26.2.0",
		"@types/sortablejs": "^1.15.8",
		"@typescript-eslint/typescript-estree": "^8.67.0",
		"github-actionlint": "^1.7.12",
		"lint-staged": "^17.3.0",
		"markdownlint-cli2": "^0.23.2",
		"shellcheck": "^4.1.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vercel": "^58.9.0"
	}
}
