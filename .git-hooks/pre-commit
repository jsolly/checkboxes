#!/usr/bin/env bash
((BASH_VERSINFO[0] >= 5)) || { echo "✗ $0 requires Bash >= 5, not $BASH_VERSION. Fix: brew install bash; open a fresh shell and rerun repository setup." >&2; exit 1; }
# Pre-commit GATE for checkboxes (gate-only — this hook does NOT deploy).
#
# Repository-owned gate: committing-tree selection, staged secret scans,
# pinned runtimes and the quality checks below. Vercel owns deployment after merge.
set -euo pipefail

# shellcheck source=/dev/null
_repo_owned_gate_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$_repo_owned_gate_root/gate/gate-lib.sh"
# Gate the tree being committed, not this copy's: under an absolute core.hooksPath (Claude
# desktop worktrees) this re-execs the committing tree's own hook; it sets ROOT and cd's.
gate_enter_committing_tree "${BASH_SOURCE[0]}"

# The trusted dispatcher passes pre-commit or pre-push. A direct `npm run gate`
# leaves the argument empty and runs the commit gate.
case "${1:-pre-commit}" in
  pre-push)
    trap 'echo "✗ pre-push security scan failed — push aborted" >&2' ERR
    if [[ -t 0 ]]; then
      echo "✗ pre-push hook expects git's ref list on stdin" >&2
      exit 1
    fi
    gl="$(gate_gitleaks_bin)"
    while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
      [[ -n "${local_sha:-}" ]] || continue
      for sha in "$local_sha" "$remote_sha"; do
        if [[ ! "$sha" =~ ^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]]; then
          echo "✗ pre-push received a revision that is not a commit id" >&2
          exit 1
        fi
      done
      [[ "$local_sha" =~ ^0+$ ]] && continue
      if [[ "$remote_sha" =~ ^0+$ ]]; then
        git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null \
          || { echo "✗ a new branch needs refs/remotes/origin/main for the gitleaks range" >&2; exit 1; }
        range="refs/remotes/origin/main..${local_sha}"
      else
        range="${remote_sha}..${local_sha}"
      fi
      count="$(git rev-list --count "$range")"
      [[ "$count" != 0 ]] || continue
      merges="$(git rev-list --min-parents=3 "$range")"
      if [[ -n "$merges" ]]; then
        echo "✗ gitleaks cannot read a merge with three or more parents in $range" >&2
        exit 1
      fi
      echo "• gitleaks ($range)"
      "$gl" git --no-banner --no-color --redact --verbose \
        --log-opts="--root --text --diff-merges=remerge --no-color --no-textconv ${range}"
    done
    echo "✓ pre-push secrets scan passed"
    exit 0
    ;;
  pre-commit) ;;
  *)
    echo "✗ unknown repository hook: $1" >&2
    exit 1
    ;;
esac

gate_begin_commit "checkboxes"    # staged gitleaks; md-lint; doc-only fast path; skip on merge/amend; banner; ERR trap
run_step "bash floor" gate_check_bash_floor   # every Bash entrypoint refuses Bash < 5
gate_require_node                 # enforce the pinned Node (.nvmrc), not whatever's on PATH

# --- Quality gate (run_step: silent on green, full output + abort on red) ---
run_step "biome ci"     npx --no-install biome ci --config-path=config/quality/biome.settings.jsonc . --error-on-warnings
run_step "yaml lint"   npm run check:yaml
run_step "cfn-lint" bash scripts/security-scanners.sh cfn-lint
run_step "actionlint"             npm run check:actions
run_step "zizmor" bash scripts/security-scanners.sh zizmor
run_step "markdown lint" npm run check:md
run_step "smoke scenario" npm run smoke:scenario-contract
run_step "tests" npm test
run_step "astro check (types)" npm run check:ts
run_step "knip"        npm run check:knip
run_step "build"       npm run build

run_step "repository hook trust" bash scripts/repo-python.sh scripts/test-repo-hooks.py

echo "✓ pre-commit gate passed — commit will land; Vercel deploys via GitHub integration after merge to main."
