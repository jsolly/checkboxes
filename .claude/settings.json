{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; bash \"$CLAUDE_PROJECT_DIR/scripts/setup-agent-environment.sh\" --session-hook",
						"timeout": 600
					}
				]
			}
		]
	}
}
