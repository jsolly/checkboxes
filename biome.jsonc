{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/*.min.js",
			"!**/.agents/**/*",
			"!**/.vercel/**/*",
			"!**/.astro/**/*",
			"!**/dist/**/*",
			"!**/node_modules/**/*",
			"!**/.superpowers/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			// 2.5.14 catalog: types "recommended" enables ZERO rules (stable types
			// rules are not recommended-flagged). "all" + explicit nursery/stable.
			"types": "all",
			// Prefer "all" (recommended is only noPrivateImports). Pair with
			// explicit noImportCycles / noUndeclaredDependencies below.
			"project": "all",
			"test": "recommended",
			"tailwind": "all",
			"react": "none",
			"vue": "none",
			"svelte": "none",
			"astro": "none",
			"next": "none",
			"solid": "none",
			"qwik": "none",
			"reactNative": "none",
			"drizzle": "none",
			"playwright": "none",
			"turborepo": "none"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useArrayFind": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedInstantiation": "error",
				"noUndeclaredDependencies": "error",
				// HOLD: Astro implicit default exports + Vite/alias resolution.
				"noUnresolvedImports": "off",
				// HOLD: Vite/Astro extensionless imports.
				"useImportExtensions": "off",
				"useJsonImportAttributes": "error"
			},
			"nursery": {
				"noAstroSetHtmlDirective": "error",
				"noBaseToString": "error",
				"noConditionalExpect": "error",
				"noDuplicateFieldDefinitionNames": "error",
				"noDuplicateSelectors": "error",
				"noEmptyObjectKeys": "error",
				"noExtendNative": "error",
				"noFloatingPromises": "error",
				"noIdenticalTestTitle": "error",
				"noImpliedEval": "error",
				"noInvalidFileInputAccept": "error",
				"noInvalidPropertyInitValue": "error",
				"noJsxLeakedDollar": "error",
				"noJsonUnsafeValues": "error",
				"noLoopFunc": "error",
				"noObsoleteTags": "error",
				"noMisleadingReturnType": "error",
				"noMisusedPromises": "error",
				"noNegationInEqualityCheck": "error",
				"noReturnInFinally": "error",
				"noSvelteAtDebugTags": "error",
				"noSvelteAtHtmlTags": "error",
				"noSvelteLegacyConst": "error",
				"noSvelteUnnecessaryStateWrap": "error",
				"noTailwindArbitraryValue": "error",
				"noUnmodifiedLoopCondition": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noUnsafeIframeSandbox": "error",
				"noUnsafePlusOperands": "error",
				"noUnusedClasses": "error",
				"noUselessTypeConversion": "error",
				"noVueDeprecatedScopedSlots": "error",
				"noVueImportCompilerMacros": "error",
				"noVueUndeclaredDirectives": "error",
				"noVueRefAsOperand": "error",
				"noVueVOnNumberValues": "error",
				"noXorAsExponentiation": "error",
				"useArraySome": "error",
				"useAstroClientOnlyDirectiveValue": "error",
				"useAwaitThenable": "error",
				"useBetterDomTraversing": "error",
				"useConsistentObjectKeys": "error",
				"useConsistentTestIt": "error",
				"useControlLabel": "error",
				"useDisposables": "error",
				"useDomNodeTextContent": "error",
				"useDomQuerySelector": "error",
				"useExhaustiveSwitchCases": "error",
				"useFlatMathMinMax": "error",
				"useIframeSandbox": "error",
				"useImportsFirst": "error",
				"useIncludes": "error",
				"useLayeredStyles": "error",
				"useMathMinMax": "error",
				"useModernMathApis": "error",
				"useNamedLayer": "error",
				"useNullishCoalescing": "error",
				"useReduceTypeParameter": "error",
				"useRegexpExec": "error",
				"useRegexpTest": "error",
				"useStringStartsEndsWith": "error",
				"useSvelteRequireEachKey": "error",
				"useTailwindShorthandClasses": "error",
				"useTestHooksInOrder": "error",
				"useTestHooksOnTop": "error",
				"useThisInClassMethods": "error",
				"useVueBaseImport": "error",
				"useVueNextTickPromise": "error",
				"useVueValidVFor": "error"
			},
			"performance": {
				"noBarrelFile": "error"
			},
			"security": {
				"noSecrets": {
					"level": "error",
					"options": {
						"entropyThreshold": 50
					}
				}
			},
			"style": {
				"useConsistentEnumValueType": "error",
				"useErrorCause": "error",
				"useExportType": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error"
			},
			"suspicious": {
				"noDeprecatedImports": "error",
				"noDuplicateTestHooks": "error",
				"noExportsInTest": "error",
				"noFocusedTests": "error",
				"noForIn": "error",
				"noImplicitAnyLet": "error",
				"noImportCycles": "error",
				"noNestedPromises": "error",
				"noShadow": "error",
				"noShadowRestrictedNames": "error",
				"noTsIgnore": "error",
				"noUnnecessaryConditions": "error",
				"useArraySortCompare": "error",
				"useAwait": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.jsx", "**/*.tsx"],
			"linter": {
				"domains": {
					"react": "all",
					"vue": "none",
					"svelte": "none"
				}
			}
		},
		{
			"includes": ["**/*.vue"],
			"linter": {
				"domains": {
					"vue": "all",
					"react": "none",
					"svelte": "none"
				},
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					},
					"nursery": {
						"useVueConsistentDefinePropsDeclaration": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"domains": {
					"svelte": "all",
					"react": "none",
					"vue": "none"
				},
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"domains": {
					"astro": "all",
					"react": "none",
					"vue": "none",
					"svelte": "none"
				},
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["tests/**"],
			"linter": {
				"domains": {
					"test": "all"
				},
				"rules": {
					"nursery": {
						"useExpect": "off",
						// Root enablement false-positives on RegExp.prototype.test.
						"useValidTestTitle": "error"
					}
				}
			}
		}
	]
}
