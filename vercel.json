{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": {
			"main": true,
			"*": false,
			"*/*": false,
			"*/*/*": false,
			"*/*/*/*": false,
			"**": false
		}
	},
	"headers": [
		{
			"source": "/release.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-store"
				},
				{
					"key": "CDN-Cache-Control",
					"value": "no-store"
				},
				{
					"key": "Vercel-CDN-Cache-Control",
					"value": "no-store"
				}
			]
		}
	]
}
