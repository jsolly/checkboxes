---
import type { ComponentProps } from "astro/types";
import UpdateNotice from "../components/UpdateNotice.svelte";
import Layout from "./Layout.astro";

type Props = ComponentProps<typeof Layout>;
// biome-ignore lint/complexity/useLiteralKeys: Astro environment keys use an index signature.
const release = import.meta.env["PUBLIC_WEBSITE_RELEASE"] ?? "";
---
<Layout {...Astro.props} {release}>
 <UpdateNotice slot="notice" {release} client:load />
 <slot />
</Layout>

<script>
 import { injectSpeedInsights } from "@vercel/speed-insights";

 if (import.meta.env.PROD && window.location.hostname === "www.checkboxes.xyz" && navigator.onLine) {
  injectSpeedInsights({
   beforeSend(event) {
    const url = new URL(event.url);
    url.search = "";
    url.hash = "";
    return { ...event, url: url.href };
   },
  });
 }
</script>
