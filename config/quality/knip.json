{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"src/pages/**/*.{astro,ts,js}",
		"src/styles/checkbox-demo-classes.jsx",
		"scripts/**/*.{mjs,js,ts}",
		"tests/**/*.test.ts"
	],
	"project": [
		"src/**/*.{ts,tsx,js,jsx,mjs,astro,vue,svelte,css}",
		"scripts/**/*.{mjs,js,ts}",
		"tests/**/*.ts"
	],
	"ignore": ["src/vendor/**"],
	"ignoreBinaries": ["uvx"],
	"ignoreDependencies": ["markdownlint-cli2"],
	"astro": {
		"config": ["config/app/astro.mjs"]
	},
	"svelte": { "entry": ["config/app/svelte.js"] },
	"biome": { "config": ["config/quality/biome.settings.jsonc"] },
	"lint-staged": { "config": ["config/quality/lint-staged.json"] }
}
