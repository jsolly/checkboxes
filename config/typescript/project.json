{
	"extends": ["astro/tsconfigs/strict", "./strict-astro.json"],
	"include": ["../../.astro/types.d.ts", "../../**/*"],
	"exclude": ["../../dist"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["sortablejs"],
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"paths": {
			"$lib": ["${configDir}/src/lib"],
			"$lib/*": ["${configDir}/src/lib/*"]
		}
	}
}
